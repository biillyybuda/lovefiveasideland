# Copy these values into your local environment or .streamlit/secrets.toml.
# Never commit real secrets.

# Recommended single Postgres connection string:
DATABASE_URL=

# Or use individual Postgres values:
PGHOST=
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGPORT=5432
PGCONNECT_TIMEOUT=5

# Supabase Auth / PostgREST client:
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Used to sign the local auth cookie payload:
COOKIE_SECRET=

# Optional:
LOVEFIVE_DISABLE_DB_POOL=false
